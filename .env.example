# Core app
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-chat

# Security
APP_API_KEYS=test-key
DEV_BYPASS_AUTH=false

# Redis
REDIS_URL=redis://localhost:6379/0

# A module runtime defaults
MEMORY_TTL_SECONDS=3600
MEMORY_MAX_TURNS=10
RATE_LIMIT_PER_MINUTE=30
MAX_CONCURRENT_PER_KEY=2
LOCK_TTL_SECONDS=30

# B module: docs, index, embedding
RAG_DOCS_DIR=knowledge/dogs
RAG_INDEX_PATH=knowledge/index/dog_basic_index.json
RAG_DEFAULT_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_SCORE_THRESHOLD=0.3
RAG_ANSWER_SCORE_THRESHOLD=0.42
RAG_SOURCE_SCORE_THRESHOLD=0.54
RAG_SYMPTOM_ANSWER_SCORE_THRESHOLD=0.52
RAG_SYMPTOM_SOURCE_SCORE_THRESHOLD=0.66
RAG_EMBEDDING_MODE=local
RAG_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
